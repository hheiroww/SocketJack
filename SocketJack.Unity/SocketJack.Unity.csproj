<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SocketJack.Multiplayer</RootNamespace>
    <AssemblyName>SocketJack.Unity</AssemblyName>
    <Version>2026.11.03.2</Version>
    <Authors>hheiroww</Authors>
    <Description>Multiplayer networking for Unity 6, Unity 2022.3 and dedicated .NET servers. UDP/TCP transports, locally predicted physics, selected field/property replication, per-member authority and configurable serializers.</Description>
    <PackageId>SocketJack.Unity</PackageId>
    <PackageTags>Unity;Unity6;Multiplayer;Networking;UDP;TCP;Game;DedicatedServer;StateSync;Serialization</PackageTags>
    <RepositoryUrl>https://github.com/hheiroww/SocketJack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hheiroww/SocketJack</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>SocketJackUnityIcon.png</PackageIcon>
    <PackageReleaseNotes>Adds opt-in field/property replication with per-member authority and a configurable game-state serializer. SocketJack binary formatting is the default. Includes UDP and TCP transport choices, Unity 6 primary support, a Unity 2022.3 LTS compatibility bracket, render-pipeline-independent networking and an expanded offline setup guide. Use matching builds, prefab schemas and serializer settings on every participant.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);SOCKETJACK_UNITY</DefineConstants>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Transport/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <Compile Include="Physics/**/*.cs" />
    <Compile Include="../SocketJack/Net/ObjectRebuilder.cs" Link="Serialization/ObjectRebuilder.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../docs/Unity-AssetStore-QuickStart.md" Pack="true" PackagePath="/QuickStart.md" />
    <None Include="SocketJackUnityIcon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="Unity/*.cs;Unity/link.xml" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/" BuildAction="None" PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
