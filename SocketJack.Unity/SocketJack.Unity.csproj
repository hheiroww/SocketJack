<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SocketJack.Multiplayer</RootNamespace>
    <AssemblyName>SocketJack.Unity</AssemblyName>
    <Version>2026.11.04.0</Version>
    <Authors>hheiroww</Authors>
    <Description>Turn an existing Unity game into multiplayer. Unity 6 and 2022.3, UDP/TCP/WebSocket, predicted 3D/2D physics, selected field/property sync, quantization, spatial visibility and lifecycle tools. Optional Web and Voice packages add self-hosted MMO services.</Description>
    <PackageId>SocketJack.Unity</PackageId>
    <PackageTags>Unity;Unity6;Multiplayer;Networking;UDP;TCP;Game;DedicatedServer;StateSync;Serialization</PackageTags>
    <RepositoryUrl>https://github.com/hheiroww/SocketJack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hheiroww/SocketJack</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>SocketJackUnityIcon.png</PackageIcon>
    <PackageReleaseNotes>Release two: existing-prefab setup, real Rigidbody2D, 3D/custom motors, configurable member synchronization, manual/adaptive quantization, spatial visibility, scene/lifecycle/ownership/pooling tools, WebSocket/WebGL gameplay and authenticated self-hosted relays. Optional Web/Voice modules add accounts, MMO chat, persistent Communities, linked servers, a monochrome website and Opus voice. Session protocol 3 requires matching upgraded players/servers. Unity 6 primary; 2022.3 compatibility. See ReleaseTwo.md for setup, dependencies and tested boundaries.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);SOCKETJACK_UNITY</DefineConstants>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Transport/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <Compile Include="Physics/**/*.cs" />
    <Compile Include="../SocketJack/Net/ObjectRebuilder.cs" Link="Serialization/ObjectRebuilder.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../docs/Unity-AssetStore-QuickStart.md" Pack="true" PackagePath="/QuickStart.md" />
    <None Include="../docs/Unity-ReleaseTwo.md" Pack="true" PackagePath="/ReleaseTwo.md" />
    <None Include="SocketJackUnityIcon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="Unity/*.cs;Unity/link.xml" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/" BuildAction="None" PackageCopyToOutput="true" />
    <None Include="Unity/Editor/*.cs" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/Editor/" BuildAction="None" PackageCopyToOutput="true" />
    <None Include="Unity/Plugins/*.jslib" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/Plugins/" BuildAction="None" PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
