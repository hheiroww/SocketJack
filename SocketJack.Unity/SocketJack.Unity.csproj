<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SocketJack.Unity</RootNamespace>
    <AssemblyName>SocketJack.Unity</AssemblyName>
    <Version>2026.11.02.0</Version>
    <Authors>hheiroww</Authors>
    <Description>Authoritative multiplayer networking for Unity and dedicated .NET servers. Bounded UDP and TCP transports, rooms, ownership, replicated state and main-thread Unity adapters.</Description>
    <PackageId>SocketJack.Unity</PackageId>
    <PackageTags>Unity;Multiplayer;Networking;UDP;TCP;Game;DedicatedServer</PackageTags>
    <RepositoryUrl>https://github.com/hheiroww/SocketJack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hheiroww/SocketJack</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial portable Unity multiplayer package with explicit transports, authoritative object replication, rooms, ownership and Unity component sources.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Transport/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="Unity/*.cs;Unity/link.xml" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/" BuildAction="None" PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
