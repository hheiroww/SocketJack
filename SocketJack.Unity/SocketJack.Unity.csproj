<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SocketJack.Multiplayer</RootNamespace>
    <AssemblyName>SocketJack.Unity</AssemblyName>
    <Version>2026.11.03.0</Version>
    <Authors>hheiroww</Authors>
    <Description>Authoritative multiplayer networking for Unity and dedicated .NET servers. Bounded UDP and TCP transports, rooms, ownership, replicated state and main-thread Unity adapters.</Description>
    <PackageId>SocketJack.Unity</PackageId>
    <PackageTags>Unity;Multiplayer;Networking;UDP;TCP;Game;DedicatedServer</PackageTags>
    <RepositoryUrl>https://github.com/hheiroww/SocketJack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hheiroww/SocketJack</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>SocketJackUnityIcon.png</PackageIcon>
    <PackageReleaseNotes>Prepares the Asset Store edition with SocketJack.Multiplayer code namespaces, namespaced samples and Tools/SocketJack editor menus. Existing consumers must update using directives from SocketJack.Unity to SocketJack.Multiplayer; package and assembly identity remain SocketJack.Unity. Includes local physics prediction, interpolation/extrapolation, binary inputs, reliable unordered UDP, automatic MTU-safe reconstruction, topology/authority options and automatic UPnP mapping.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);SOCKETJACK_UNITY</DefineConstants>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Transport/**/*.cs" />
    <Compile Include="Runtime/**/*.cs" />
    <Compile Include="Physics/**/*.cs" />
    <Compile Include="../SocketJack/Net/ObjectRebuilder.cs" Link="Serialization/ObjectRebuilder.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="SocketJackUnityIcon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="Unity/*.cs;Unity/link.xml" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity/" BuildAction="None" PackageCopyToOutput="true" />
  </ItemGroup>
</Project>
