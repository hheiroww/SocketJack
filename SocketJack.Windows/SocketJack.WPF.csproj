    <Copyright>Copyright © JackOfFates 2026</Copyright>
    <AssemblyVersion>2026.7.0.0</AssemblyVersion>
    <FileVersion>2026.7.0.0</FileVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <Title>SocketJack</Title>
    <Description>High-performance, fully managed .NET networking library for TCP, UDP, and WebSocket communication. LLM. Features built-in peer-to-peer with NAT traversal, pluggable System.Text.Json serialization, SslStream TLS 1.2 encryption, GZip/Deflate compression, bandwidth throttling, and live WPF control sharing. Send any object across a unified, transport-agnostic API. Targets .NET Standard 2.1, .NET 8</Description>
    <IsPackable>True</IsPackable>
    <Company>JackOfFates</Company>
    <Version>2026.12</Version>
    <BuildPackage>true</BuildPackage>
    <NeutralLanguage>en-001</NeutralLanguage>
    <IncludeSymbols>False</IncludeSymbols>
    <ImportedNamespaces>System.Text.Json=False,System.Text.Json.Serialization=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,SocketJack=True</ImportedNamespaces>
    <PackageReleaseNotes>2026.7 aligns the WPF package line with SocketJack 2026.11 TypeScript client generation.</PackageReleaseNotes>
    <PackageProjectUrl>https://www.nuget.org/packages/SocketJack.WPF/</PackageProjectUrl>
    <PackageIcon>SocketJackWpfIcon.png</PackageIcon>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JackOfFates/SocketJack</RepositoryUrl>
    <PackageTags>Socket; Sockets; Jack; Serialization; Json; Networking; Managed; TCP; Client; TcpClient; TcpServer; Server; P2P; Peer; To; Generic; Compressed; Multi Threaded; Concurrent; Multi Platform; WebSocket; WebSockets; WPF; Remote; Control </PackageTags>
    <UseWPF>True</UseWPF>
