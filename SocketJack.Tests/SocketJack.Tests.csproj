<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocketJack\SocketJack.csproj" />
    <ProjectReference Include="..\Tests\CompatibilityContracts\V1\Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Tests\CompatibilityContracts\V2\Contracts.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Tests\CompatibilityContracts\Broken\Contracts.csproj" ReferenceOutputAssembly="false" />

  </ItemGroup>

  <Target Name="CopyCompatibilityFixtures" AfterTargets="Build">
    <ItemGroup>
      <ContractFixture Include="..\Tests\CompatibilityContracts\V1\bin\$(Configuration)\net8.0\Compatibility.Contracts.dll"><Version>V1</Version></ContractFixture>
      <ContractFixture Include="..\Tests\CompatibilityContracts\V2\bin\$(Configuration)\net8.0\Compatibility.Contracts.dll"><Version>V2</Version></ContractFixture>
      <ContractFixture Include="..\Tests\CompatibilityContracts\Broken\bin\$(Configuration)\net8.0\Compatibility.Contracts.dll"><Version>Broken</Version></ContractFixture>
    </ItemGroup>
    <Copy SourceFiles="@(ContractFixture)" DestinationFiles="@(ContractFixture->'$(OutDir)Contracts\%(Version)\Compatibility.Contracts.dll')" />
  </Target>
</Project>
