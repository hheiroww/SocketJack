<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SocketJack.Multiplayer.Voice</RootNamespace>
    <Version>2026.11.04.0</Version>
    <PackageId>SocketJack.Unity.Voice</PackageId>
    <Description>Optional bounded Opus voice, authenticated channel routing and Unity capture/playback for SocketJack.Unity.</Description>
    <Authors>hheiroww</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hheiroww/SocketJack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>SocketJackUnityIcon.png</PackageIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SocketJack.Unity/SocketJack.Unity.csproj" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <Compile Include="Runtime/**/*.cs" />
    <None Include="Unity/**/*.cs" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity.Voice/" BuildAction="None" />
    <None Include="Plugins/WebGL/*.jslib" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity.Voice/Plugins/WebGL/" BuildAction="None" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../SocketJack.Unity/SocketJackUnityIcon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
