    <None Include="../SocketJack.Unity.Web/Unity/link.xml" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity.Web.Client/" BuildAction="None" />
    <None Include="../SocketJack.Unity.Web/Unity/SocketJackWebSessionControls.cs" Pack="true" PackagePath="contentFiles/any/any/SocketJack.Unity.Web.Client/" BuildAction="None" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../SocketJack.Unity/SocketJackUnityIcon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
