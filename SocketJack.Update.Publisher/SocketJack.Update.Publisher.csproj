<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyTitle>SocketJack Update Publisher</AssemblyTitle>
    <Product>SocketJack Update Publisher</Product>
    <BuildInstallerOnPublisherBuild Condition="'$(BuildInstallerOnPublisherBuild)' == ''">true</BuildInstallerOnPublisherBuild>
    <InstallerBuildPlatform Condition="'$(InstallerBuildPlatform)' == ''">x64</InstallerBuildPlatform>
    <heirowLLMBootstrapPublishDir Condition="'$(heirowLLMBootstrapPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\heirowLLMBridgeInstaller\publish\</heirowLLMBootstrapPublishDir>
  </PropertyGroup>

  <Target Name="BuildheirowLLMInstaller" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildInstallerOnPublisherBuild)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\heirowLLMInstaller\heirowLLMInstaller.wixproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(InstallerBuildPlatform);ErrorOnDuplicatePublishOutputFiles=false" />
  </Target>

  <Target Name="BuildheirowLLMBootstrapInstaller" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildInstallerOnPublisherBuild)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\heirowLLMBridgeInstaller\heirowLLMBridgeInstaller.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishReadyToRun=false;PublishDir=$(heirowLLMBootstrapPublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
